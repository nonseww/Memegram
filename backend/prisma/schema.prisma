generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model comments {
  id         Int       @id @default(autoincrement())
  user_id    Int
  post_id    Int
  text       String
  created_at DateTime? @default(now()) @db.Timestamp(6)
  posts      posts     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_comment_post")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_comment_user")

  @@index([post_id], map: "idx_comments_post_id")
  @@index([user_id], map: "idx_comments_user_id")
}

model likes {
  id      Int   @id @default(autoincrement())
  user_id Int
  post_id Int
  posts   posts @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_like_post")
  users   users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_like_user")

  @@unique([user_id, post_id], map: "unique_user_post_like")
  @@index([post_id], map: "idx_likes_post_id")
  @@index([user_id], map: "idx_likes_user_id")
}

model posts {
  id          Int        @id @default(autoincrement())
  title       String     @db.VarChar(255)
  description String?    @db.VarChar(3000)
  image_url   String     @db.VarChar(255)
  user_id     Int
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  comments    comments[]
  likes       likes[]
  users       users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")

  @@index([user_id], map: "idx_posts_user_id")
}

model follows {
  id           Int       @id @default(autoincrement())
  follower_id  Int
  following_id Int
  created_at   DateTime? @default(now()) @db.Timestamp(6)

  follower     users     @relation("followers", fields: [follower_id], references: [id], onDelete: Cascade)
  following    users     @relation("followings", fields: [following_id], references: [id], onDelete: Cascade)

  @@unique([follower_id, following_id])
  @@index([follower_id])
  @@index([following_id])
}

model users {
  id         Int        @id @default(autoincrement())
  username   String     @unique @db.VarChar(255)
  name       String     @db.VarChar(255)
  about      String?    @db.VarChar(300)
  role       String?    @default("user") @db.VarChar(50)
  email      String     @unique @db.VarChar(255)
  password   String     @db.VarChar(255)
  avatar_url String?    @db.VarChar(255)
  cover_url  String?    @db.VarChar(255)
  created_at DateTime?  @default(now()) @db.Timestamp(6)
  comments   comments[]
  likes      likes[]
  posts      posts[]
  followers  follows[]  @relation("followings")  
  followings follows[]  @relation("followers") 
}
